{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/agent-ix/quire-contract-runtime/schemas/runtime-evidence-input-v1.schema.json",
  "title": "Runtime evidence collection input v1",
  "description": "SPDX-License-Identifier: MIT OR Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRevision", "sourceState", "commands", "tools", "toolDigests", "pgm01"],
  "properties": {
    "schemaVersion": {"const": "quire.runtime-evidence-input/v1"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "sourceState": {"enum": ["clean", "modified"]},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo", "jsonschema", "kani", "python", "quire", "rustc", "rust-msrv", "size"],
      "properties": {
        "cargo": {"type": "string", "minLength": 1},
        "jsonschema": {"type": "string", "minLength": 1},
        "kani": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "quire": {"type": "string", "minLength": 1},
        "rustc": {"type": "string", "minLength": 1},
        "rust-msrv": {"type": "string", "minLength": 1},
        "size": {"type": "string", "minLength": 1}
      }
    },
    "toolDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo", "cargo-kani", "make", "python", "quire", "rustc", "size"],
      "properties": {
        "cargo": {"$ref": "#/definitions/toolIdentity"},
        "cargo-kani": {"$ref": "#/definitions/toolIdentity"},
        "make": {"$ref": "#/definitions/toolIdentity"},
        "python": {"$ref": "#/definitions/toolIdentity"},
        "quire": {"$ref": "#/definitions/toolIdentity"},
        "rustc": {"$ref": "#/definitions/toolIdentity"},
        "size": {"$ref": "#/definitions/toolIdentity"}
      }
    },
    "pgm01": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "candidateRevision", "envelopeSchema", "envelopeSchemaDigest", "schemaPath", "schemaDigest", "validatorPath", "validatorDigest", "validatorRevision"],
      "properties": {
        "policy": {"const": "ix://agent-ix/quire-contract-ir/PGM-01"},
        "candidateRevision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "envelopeSchema": {"const": "quire.derivation-evidence/v1"},
        "envelopeSchemaDigest": {"$ref": "#/definitions/digest"},
        "schemaPath": {"type": "string", "minLength": 1},
        "schemaDigest": {"$ref": "#/definitions/digest"},
        "validatorPath": {"type": "string", "minLength": 1},
        "validatorDigest": {"$ref": "#/definitions/digest"},
        "validatorRevision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    }
  },
  "definitions": {
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/definitions/digest"}
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
